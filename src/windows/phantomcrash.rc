// The executable's manifest (UTF-8 as the code page) and the properties Explorer shows, with the
// build stamp (cmake/release.cmake)
#include <winver.h>

#include "build_stamp.h"

1 24 "phantomcrash.manifest"

1 VERSIONINFO
FILEVERSION 0, 0, 0, 0
PRODUCTVERSION 0, 0, 0, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "ProductName", "OpenPCrash"
            VALUE "FileDescription", "OpenPCrash"
            VALUE "InternalName", "openpcrash"
            VALUE "OriginalFilename", "OpenPCrash.exe"
            VALUE "ProductVersion", PHANTOMCRASH_GAME_VERSION
            VALUE "FileVersion", PHANTOMCRASH_GAME_VERSION
            VALUE "Commit", PHANTOMCRASH_COMMIT
            VALUE "BuildDate", PHANTOMCRASH_BUILD_DATE
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
